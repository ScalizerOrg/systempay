<odoo>
    <data>
        <record id="provider_form_systempay" model="ir.ui.view">
            <field name="name">Systempay Provider Form</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form" />
            <field name="arch" type="xml">
                <group name="provider_credentials" position='after'>
                    <div invisible="code not in ('systempay', 'systempaymulti')">
                        <group name="systempay_module_information" string="MODULE INFORMATION">
                            <field name="systempay_doc" />
                        </group>
                        <group name="systempay_gateway_access" string="PAYMENT GATEWAY ACCESS">
                            <field name="systempay_site_id" autocomplete="off" required="code in ('systempay', 'systempaymulti')" />
                            <field name="systempay_key_test" autocomplete="off" required="code in ('systempay', 'systempaymulti')" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'" />
                            <field name="systempay_key_prod" autocomplete="off" required="code in ('systempay', 'systempaymulti')" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'" />
                            <field name="systempay_sign_algo" required="code in ('systempay', 'systempaymulti')" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'" />
                            <field name="systempay_notify_url" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'" />
                        </group>
                        <div invisible="code != 'systempay'">
                            <group name="systempay_rest_api_keys" string="REST API KEYS" invisible="systempay_payment_data_entry_mode == 'redirect'">
                                <field name="systempay_test_password" autocomplete="off" password="True" />
                                <field name="systempay_prod_password" autocomplete="off" password="True" />
                                <field name="systempay_public_test_key" autocomplete="off" />
                                <field name="systempay_public_production_key" autocomplete="off" />
                                <field name="systempay_sha256_test_key" autocomplete="off" password="True" />
                                <field name="systempay_sha256_prod_key" autocomplete="off" password="True" />
                                <field name="systempay_rest_api_notify_url" />
                            </group>
                            <group name="systempay_advanced_options" string="ADVANCED OPTIONS" >
                                <field name="systempay_payment_data_entry_mode" required="code == 'systempay'" />
                                <field name="systempay_embedded_pop_in" required="code == 'systempay'" invisible="systempay_payment_data_entry_mode == 'redirect'" />
                                <field name="systempay_embedded_theme" required="code == 'systempay'" invisible="systempay_payment_data_entry_mode == 'redirect'" />
                                <field name="systempay_embedded_compact_mode" required="code == 'systempay'" invisible="systempay_payment_data_entry_mode == 'redirect'" />
                                <field name="systempay_embedded_payment_attempts" invisible="systempay_payment_data_entry_mode == 'redirect'" />
                            </group>
                        </div>
                        <group string="PAYMENT PAGE">
                            <field name="systempay_language" required="code in ('systempay', 'systempaymulti')" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'" />
                            <field name="systempay_available_languages" widget="many2many_tags" options="{'no_create': True}" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'" />
                            <field name="systempay_capture_delay" />
                            <field name="systempay_validation_mode" required="code in ('systempay', 'systempaymulti')" />
                            <field name="systempay_payment_cards" widget="many2many_tags" options="{'no_create': True}" />
                        </group>
                        <group name="systempay_selective_3ds" string="CUSTOM 3DS" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'">
                            <field name="systempay_threeds_min_amount" />
                        </group>
                        <group string="RETURN TO SHOP" invisible="code == 'systempay' and systempay_payment_data_entry_mode != 'redirect'">
                            <field name="systempay_redirect_enabled" required="code in ('systempay', 'systempaymulti')" />
                            <field name="systempay_redirect_success_timeout" />
                            <field name="systempay_redirect_success_message" />
                            <field name="systempay_redirect_error_timeout" />
                            <field name="systempay_redirect_error_message" />
                            <field name="systempay_return_mode" required="code in ('systempay', 'systempaymulti')" />
                        </group>
                    </div>
                </group>
            </field>
        </record>

        <record id="transaction_form_systempay" model="ir.ui.view">
            <field name="name">Systempay Transaction Form</field>
            <field name="model">payment.transaction</field>
            <field name="inherit_id" ref="payment.payment_transaction_form" />
            <field name="arch" type="xml">
                <field name="provider_reference" position="after">
                    <field name="systempay_trans_status" invisible="provider_code not in ('systempay', 'systempaymulti')" />
                    <field name="systempay_card_brand" invisible="provider_code not in ('systempay', 'systempaymulti')" />
                    <field name="systempay_card_number" invisible="provider_code not in ('systempay', 'systempaymulti')" />
                    <field name="systempay_expiration_date" invisible="provider_code not in ('systempay', 'systempaymulti')" />
                    <field name="systempay_auth_result" invisible="provider_code not in ('systempay', 'systempaymulti')" />
                </field>

                <xpath expr="//form/sheet/group[last()]" position="after">
                    <group string="Transaction log" invisible="provider_code not in ('systempay', 'systempaymulti')">
                        <field name="systempay_raw_data" nolabel="1" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>

    <function model="payment.provider" name="multi_add">
        <value>/views/payment_provider_views_multi.xml</value>
        <value>False</value>
    </function>
</odoo>
